# /etc/conf.d/bitcoinII-d: config file for /etc/init.d/bitcoinII-d

# Config file location
#BITCOINIID_CONFIGFILE="/etc/bitcoinII/bitcoinII.conf"

# What directory to write pidfile to?  (created and owned by $BITCOINIID_USER)
#BITCOINIID_PIDDIR="/var/run/bitcoinII-d"

# What filename to give the pidfile
#BITCOINIID_PIDFILE="${BITCOINIID_PIDDIR}/bitcoinII-d.pid"

# Where to write bitcoinII-d data (be mindful that the blockchain is large)
#BITCOINIID_DATADIR="/var/lib/bitcoinII-d"

# User and group to own bitcoinII-d process
#BITCOINIID_USER="bitcoinII"
#BITCOINIID_GROUP="bitcoinII"

# Path to bitcoinII-d executable
#BITCOINIID_BIN="/usr/bin/bitcoinII-d"

# Nice value to run bitcoinII-d under
#BITCOINIID_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#BITCOINIID_OPTS=""

# The timeout in seconds OpenRC will wait for bitcoinII-d to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
BITCOINIID_SIGTERM_TIMEOUT=600
